<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The fixture shows WinForms' own dialogs as well (DialogProducers). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms types are named where they are used, beside FlaUI's and WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UltraExplorer/UltraExplorer.csproj" />
    <Compile Include="../ViewAllSmoke/NativeDialogFixture.cs" Link="NativeDialogFixture.cs" />
  </ItemGroup>
</Project>
