<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>UltraExplorer.FastEntryPoint</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>UltraExplorer</AssemblyName>
    <RootNamespace>UltraExplorer</RootNamespace>
    <VersionPrefix>1.3.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UltraExplorer.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Self-contained single file is a publish-time decision passed on the
       command line, so ordinary builds stay framework-dependent and the test
       harness can reference this project. See BUILD.md for the publish command. -->

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.17.2" />
  </ItemGroup>

  <!-- The nested canvas draws on the GPU: Direct3D 11 renders into a texture
       shared with a Direct3D9Ex surface that WPF shows through D3DImage, and
       DirectWrite supplies glyph shapes for the text atlas.  Managed bindings
       only - they call the system's d3d11, dxgi, d3d9 and dwrite.  Pinned. -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\UltraExplorer.ico" />
    <Content Include="..\..\runtime\preview\**\*" Link="preview\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\runtime\archives\**\*" Link="archives\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\docs\preview-licenses\**\*" Link="preview\licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The canvas's shaders, compiled at start-up by ShaderCache with the
       system's d3dcompiler_47.dll and kept in the state folder. -->
  <ItemGroup>
    <None Remove="Rendering\Gpu\Shaders\*.hlsl" />
    <EmbeddedResource Include="Rendering\Gpu\Shaders\*.hlsl" />
  </ItemGroup>

  <!-- The headless harness exercises the graph internals directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ViewAllSmoke" />
    <InternalsVisibleTo Include="NativeDialogProxySmoke" />
  </ItemGroup>
</Project>
