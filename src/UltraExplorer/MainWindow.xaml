<Window x:Class="UltraExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:controls="clr-namespace:UltraExplorer.Controls"
        xmlns:models="clr-namespace:UltraExplorer.Models"
        xmlns:converters="clr-namespace:UltraExplorer.Converters"
        xmlns:infra="clr-namespace:UltraExplorer.Infrastructure"
        mc:Ignorable="d"
        Title="UltraExplorer"
        Icon="Assets/UltraExplorer.ico"
        Width="1520"
        Height="900"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        Style="{StaticResource AppWindow}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6,3,6,6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility" />
        <infra:BindingProxy x:Key="Shell" Data="{Binding}" />

        <!-- A column header like the ones over Explorer's details view: flat,
             lit on hover, and never taking the keyboard - focus stays on the
             canvas or the filter box, so Enter, Delete and Space keep meaning
             what they mean there.  The sort arrow sits centred above the
             label, where Windows 11 puts it. -->
        <Style x:Key="SortHeaderButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#252525" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The arrow over a header: there on every header so the labels line
             up, seen only on the one the canvas is ordered by. -->
        <Style x:Key="SortHeaderArrow" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Text" Value="&#xE70E;" />
            <Setter Property="Visibility" Value="Hidden" />
        </Style>

        <Style x:Key="SortHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- One row of an address suggestion, used both under the line and
             behind a crumb's chevron. -->
        <DataTemplate x:Key="AddressSuggestionTemplate" DataType="{x:Type models:AddressSuggestion}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}"
                           Style="{StaticResource IconText}"
                           FontSize="12"
                           Foreground="{Binding Tint}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           ToolTip="{Binding FullPath}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="6,0,10,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Detail}"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="10"
                           MaxWidth="240"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="AddressSuggestionList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="MaxHeight" Value="304" />
            <Setter Property="ItemTemplate" Value="{StaticResource AddressSuggestionTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />

            <!-- The list never takes the keyboard: the caret stays in the line
                 while the arrow keys walk this, which is what makes typing and
                 choosing the same gesture. -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="7,5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type models:FavoriteItemViewModel}">
            <Button Style="{StaticResource SidebarItem}"
                    Tag="{Binding StateTag}"
                    ToolTip="{Binding ToolTipText}"
                    AutomationProperties.Name="{Binding Name}"
                    Command="{Binding Data.OpenSidebarItemCommand, Source={StaticResource Shell}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" HorizontalAlignment="Left">
                        <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Glyph}"
                                   Style="{StaticResource IconText}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Unpin from Home"
                                  Command="{Binding Data.RemoveFavoriteCommand, Source={StaticResource Shell}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="48" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Title / tab strip -->
        <Grid Grid.Row="0" Background="{StaticResource WindowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                <Border Height="34"
                        MinWidth="220"
                        MaxWidth="260"
                        CornerRadius="7,7,0,0"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Margin="10,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/UltraExplorer.ico" Width="16" Height="16" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TabTitle}"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Style="{StaticResource FlatButton}"
                                Click="CloseWindowButton_Click"
                                ToolTip="Close tab" AutomationProperties.Name="Close tab">
                            <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="9" />
                        </Button>
                    </Grid>
                </Border>
                <Button Width="32"
                        Height="32"
                        Padding="0"
                        Margin="4,0,0,1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource FlatButton}"
                        Click="NewTabButton_Click"
                        ToolTip="Reset the canvas view" AutomationProperties.Name="Reset the canvas view"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="11" />
                </Button>
            </StackPanel>

            <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <TextBlock Text="&#xE921;" Style="{StaticResource IconText}" FontSize="10" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeButton_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                    <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconText}" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="CloseWindowButton_Click" ToolTip="Close" AutomationProperties.Name="Close">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource IconText}" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation / address / search -->
        <Grid Grid.Row="1" Background="{StaticResource WindowBrush}" Panel.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button Width="32" Height="32" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="14" />
                </Button>
                <Button Width="32" Height="32" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
                    <TextBlock Text="&#xE72A;" Style="{StaticResource IconText}" FontSize="14" />
                </Button>
                <Button Width="32" Height="32" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding UpCommand}" ToolTip="Up (Alt+Up)" AutomationProperties.Name="Up">
                    <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- The address bar.  Crumbs until it is clicked, a path line
                 afterwards, and either way the path itself is one button or one
                 menu entry away from the clipboard. -->
            <Border x:Name="AddressArea"
                    Grid.Column="1"
                    Height="32"
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    PreviewMouseLeftButtonDown="AddressArea_PreviewMouseLeftButtonDown"
                    PreviewMouseRightButtonUp="AddressArea_PreviewMouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE8B7;"
                               Style="{StaticResource IconText}"
                               FontSize="13"
                               Foreground="{StaticResource FolderBrush}"
                               IsHitTestVisible="False" />

                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  Cursor="IBeam"
                                  Visibility="{Binding Address.IsShowingCrumbs, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Address.Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BreadcrumbSegment}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource FlatButton}"
                                                Height="24"
                                                Padding="6,0"
                                                Command="{Binding Data.Address.OpenSegmentCommand, Source={StaticResource Shell}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding FullPath}">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </Button>

                                        <!-- The chevron is a crumb of its own: it
                                             opens the folders that could have been
                                             taken from here instead of the one that
                                             was. -->
                                        <Button x:Name="CrumbChevron"
                                                Style="{StaticResource FlatButton}"
                                                Width="16"
                                                Height="24"
                                                Padding="0"
                                                Command="{Binding Data.Address.ToggleSegmentMenuCommand, Source={StaticResource Shell}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Folders in here"
                                                AutomationProperties.Name="Folders in here">
                                            <TextBlock Text="&#xE76C;"
                                                       Style="{StaticResource IconText}"
                                                       FontSize="7"
                                                       Foreground="{StaticResource TextDimBrush}" />
                                        </Button>

                                        <Popup PlacementTarget="{Binding ElementName=CrumbChevron}"
                                               Placement="Bottom"
                                               VerticalOffset="6"
                                               HorizontalOffset="-8"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Fade"
                                               StaysOpen="False"
                                               IsOpen="{Binding IsMenuOpen, Mode=TwoWay}">
                                            <Border MinWidth="220"
                                                    MaxWidth="460"
                                                    Padding="4"
                                                    CornerRadius="6"
                                                    Background="#F2242424"
                                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.45" Color="#000000" />
                                                </Border.Effect>
                                                <Grid>
                                                    <ListBox ItemsSource="{Binding Children}"
                                                             Style="{StaticResource AddressSuggestionList}"
                                                             PreviewMouseLeftButtonUp="AddressSuggestions_PreviewMouseLeftButtonUp" />
                                                    <TextBlock Text="{Binding EmptyText}"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               Margin="10,8"
                                                               Visibility="{Binding Children.Count, Converter={StaticResource ZeroCountToVisibility}}" />
                                                </Grid>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Column="1"
                          Visibility="{Binding Address.IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <TextBox x:Name="AddressBox"
                                 Text="{Binding Address.Text, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}"
                                 SelectionBrush="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Height="26"
                                 Padding="4,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 PreviewKeyDown="AddressBox_PreviewKeyDown"
                                 TextChanged="AddressBox_TextChanged"
                                 LostKeyboardFocus="AddressBox_LostKeyboardFocus" />

                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Width="28"
                                Height="26"
                                Padding="0"
                                Style="{StaticResource FlatButton}"
                                Command="{Binding Address.CopyCommand}"
                                ToolTip="Copy this path"
                                AutomationProperties.Name="Copy this path">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="12" />
                        </Button>
                        <Button Width="22"
                                Height="26"
                                Padding="0"
                                Style="{StaticResource FlatButton}"
                                Command="{Binding Address.ShowRecentCommand}"
                                ToolTip="Recent locations (F4)"
                                AutomationProperties.Name="Recent locations">
                            <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="10" />
                        </Button>
                        <Button Width="28"
                                Height="26"
                                Padding="0"
                                Style="{StaticResource FlatButton}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The suggestions, part of the window rather than a popup of
                 their own: a popup is a separate window, and opening one takes
                 the keyboard out of the line that opened it - the line would
                 close itself half a second after being asked for.  The row
                 paints above the rest of the window so this can hang out of it,
                 and it hangs from a canvas because a row 48 pixels tall would
                 otherwise measure the list as 4 pixels tall and show nothing. -->
            <Canvas Grid.Column="1" Margin="8,0,8,0" Height="0" VerticalAlignment="Top">
                <Border x:Name="AddressDropDown"
                        Canvas.Left="0"
                        Canvas.Top="44"
                        Width="{Binding ActualWidth, ElementName=AddressArea}"
                        Padding="4"
                        CornerRadius="6"
                        Background="#F2242424"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Visibility="{Binding Address.IsDropDownOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.45" Color="#000000" />
                    </Border.Effect>
                    <ListBox x:Name="AddressSuggestionItems"
                             ItemsSource="{Binding Address.Suggestions}"
                             SelectedItem="{Binding Address.Highlighted, Mode=TwoWay}"
                             Style="{StaticResource AddressSuggestionList}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonUp="AddressSuggestions_PreviewMouseLeftButtonUp" />
                </Border>
            </Canvas>

            <Border Grid.Column="2"
                    Width="300"
                    MinWidth="220"
                    MaxWidth="360"
                    Height="32"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}"
                                 SelectionBrush="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Height="26"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 KeyDown="SearchBox_KeyDown" />
                        <TextBlock Text="{Binding SearchPlaceholder}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextDimBrush}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                    <Button Grid.Column="1"
                            Width="28"
                            Height="26"
                            Padding="0"
                            Style="{StaticResource FlatButton}"
                            Command="{Binding SearchCommand}"
                            ToolTip="Search (Ctrl+F)" AutomationProperties.Name="Search">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Command bar -->
        <Border Grid.Row="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CommandBarButton}" Click="OrganizeButton_Click" AutomationProperties.Name="Organize">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Organize" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="8" Margin="7,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommandBarButton}" Click="GiveAccessButton_Click" AutomationProperties.Name="Give access to">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Give access to" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="8" Margin="7,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewFolderButton" Style="{StaticResource CommandBarButton}" Command="{Binding NewFolderCommand}" ToolTip="New folder (Ctrl+Shift+N)" AutomationProperties.Name="New folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,7,0" />
                            <TextBlock Text="New folder" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Margin="10,0" Background="{StaticResource BorderStrongBrush}" />

                    <Border CornerRadius="4" Padding="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource SegmentButton}"
                                          Content="View all"
                                          IsChecked="{Binding IsViewAll, Mode=TwoWay}"
                                          AutomationProperties.Name="View all"
                                          ToolTip="Every drive is a root; folders expand into their direct children" />
                            <ToggleButton Style="{StaticResource SegmentButton}"
                                          Content="View select"
                                          IsEnabled="False"
                                          IsChecked="{Binding IsViewSelect, Mode=TwoWay}"
                                          AutomationProperties.Name="View select"
                                          ToolTip="Behaviour is not defined yet" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding CollapseAllCommand}" ToolTip="Collapse every branch" AutomationProperties.Name="Collapse every branch">
                        <TextBlock Text="&#xE70E;" Style="{StaticResource IconText}" FontSize="13" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Style="{StaticResource FlatButton}" Click="LayoutButton_Click" ToolTip="Canvas options" AutomationProperties.Name="Canvas options">
                        <TextBlock Text="&#xE8A9;" Style="{StaticResource IconText}" FontSize="13" />
                    </Button>
                    <Button x:Name="SettingsButton" Width="32" Height="32" Padding="0" Style="{StaticResource FlatButton}" Click="SettingsButton_Click" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="13" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Style="{StaticResource FlatButton}" Click="PaneToggleButton_Click" ToolTip="Toggle the navigation pane" AutomationProperties.Name="Toggle the navigation pane">
                        <TextBlock Text="&#xE8A4;" Style="{StaticResource IconText}" FontSize="13" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Style="{StaticResource FlatButton}" Click="OverflowButton_Click" ToolTip="More" AutomationProperties.Name="More">
                        <TextBlock Text="&#xE712;" Style="{StaticResource IconText}" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation pane + canvas -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" MinWidth="190" MaxWidth="340" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,12">
                        <ItemsControl x:Name="PlacesItems"
                                      ItemsSource="{Binding PickerPlaces}"
                                      ItemTemplate="{StaticResource SidebarItemTemplate}"
                                      Visibility="Collapsed" />
                        <Separator x:Name="PlacesSeparator" Margin="12,8" Visibility="Collapsed" />
                        <ItemsControl ItemsSource="{Binding HomeItems}" ItemTemplate="{StaticResource SidebarItemTemplate}" />
                        <Separator x:Name="QuickAccessSeparator" Margin="12,8" />
                        <ItemsControl x:Name="QuickAccessItems" ItemsSource="{Binding QuickAccess}" ItemTemplate="{StaticResource SidebarItemTemplate}" />
                        <Separator Margin="12,8" />
                        <TextBlock Text="This PC" Margin="16,2,0,4" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                        <ItemsControl ItemsSource="{Binding Drives}" ItemTemplate="{StaticResource SidebarItemTemplate}" />
                        <Separator Margin="12,8" />
                        <ItemsControl ItemsSource="{Binding NetworkLocations}" ItemTemplate="{StaticResource SidebarItemTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2" Background="{StaticResource CanvasBrush}" ClipToBounds="True">
                <!-- The tree: nodes opened a folder at a time. -->
                <Grid x:Name="TreeCanvasHost"
                      Visibility="{Binding IsTreeLayout, Converter={StaticResource BoolToVisibility}}">
                    <nodify:NodifyEditor x:Name="Editor"
                                         Focusable="True"
                                         ItemsSource="{Binding Tree.RenderNodes}"
                                         Connections="{Binding Tree.RenderEdges}"
                                         SelectedItems="{Binding Tree.SelectedNodes}"
                                         MinViewportZoom="0.06"
                                         MaxViewportZoom="3"
                                         GridCellSize="16"
                                         BringIntoViewSpeed="2200"
                                         BringIntoViewMaxDuration="0.32"
                                         DisplayConnectionsOnTop="False"
                                         AllowDrop="True"
                                         ViewportUpdated="Editor_ViewportUpdated"
                                         PreviewDragOver="Editor_PreviewDragOver"
                                         PreviewDragLeave="Editor_PreviewDragLeave"
                                         PreviewDrop="Editor_PreviewDrop"
                                         PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown"
                                         LostMouseCapture="Editor_LostMouseCapture"
                                         PreviewMouseMove="Editor_PreviewMouseMove"
                                         PreviewMouseLeftButtonUp="Editor_PreviewMouseLeftButtonUp"
                                         PreviewMouseRightButtonDown="Editor_PreviewMouseRightButtonDown"
                                         PreviewMouseRightButtonUp="Editor_PreviewMouseRightButtonUp">
                        <nodify:NodifyEditor.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Viewbox="0,0,26,26" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#242424">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="1,1" RadiusX="0.8" RadiusY="0.8" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </nodify:NodifyEditor.Background>
                        <nodify:NodifyEditor.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ViewAllNodeViewModel}">
                                <controls:ViewAllNodeView />
                            </DataTemplate>
                        </nodify:NodifyEditor.ItemTemplate>
                        <nodify:NodifyEditor.ItemContainerStyle>
                            <Style TargetType="{x:Type nodify:ItemContainer}" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                                <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Style>
                        </nodify:NodifyEditor.ItemContainerStyle>
                        <nodify:NodifyEditor.ConnectionTemplate>
                            <DataTemplate DataType="{x:Type models:ViewAllEdgeViewModel}">
                                <nodify:StepConnection Source="{Binding SourceAnchor}"
                                                       Target="{Binding TargetAnchor}"
                                                       SourcePosition="Bottom"
                                                       TargetPosition="Top"
                                                       Stroke="{Binding Stroke}"
                                                       StrokeThickness="1.4"
                                                       CornerRadius="7"
                                                       Spacing="14"
                                                       ArrowEnds="None"
                                                       IsHitTestVisible="False" />
                            </DataTemplate>
                        </nodify:NodifyEditor.ConnectionTemplate>
                    </nodify:NodifyEditor>

                    <!-- Batched drawing of the whole graph, used instead of node
                         controls once the canvas is zoomed far enough out. -->
                    <!-- Every link on the canvas, at every zoom: one harness per
                         folder rather than a line per child. -->
                    <controls:ViewAllHarnessLayer x:Name="Harness" />

                    <controls:ViewAllOverviewLayer x:Name="Overview"
                                                   Visibility="{Binding Tree.IsOverviewActive, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Where the canvas is: the chain of folders whose blocks the
                         middle of it is inside. -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="14"
                            Padding="10,5"
                            CornerRadius="6"
                            Background="#CC1B1B1B"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            IsHitTestVisible="False"
                            Visibility="{Binding Tree.HasTrail, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Tree.Trail}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Separator}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{Binding Brush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>

                <!-- The nested canvas: every folder a cell inside its parent,
                     the whole of This PC on one screen - with a strip above it
                     that narrows it to names and orders it like Explorer's
                     column headers. -->
                <Grid x:Name="NestedHost"
                      Visibility="{Binding IsNestedLayout, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="NestedStrip"
                            Grid.Row="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- The box gives way before anything else does: it is 360
                                 wide while there is room, and narrows - down to 120 -
                                 when the window does, so the count and the arrows
                                 through the matches stay whole beside it, and the
                                 headers keep their own column.  The star column after
                                 the buttons takes whatever is spare. -->
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1000*" MinWidth="120" MaxWidth="360" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        CornerRadius="5"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="7,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE71C;"
                                                   Style="{StaticResource IconText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <Grid Grid.Column="1">
                                            <TextBlock x:Name="CanvasFilterHint"
                                                       Text="Filter by name  -  report, *.png, a;b  (Ctrl+Shift+F)"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center" />
                                            <TextBox x:Name="CanvasFilterBox"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource TextBrush}"
                                                     CaretBrush="{StaticResource TextBrush}"
                                                     FontSize="12"
                                                     VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="Filter the canvas by name"
                                                     TextChanged="CanvasFilterBox_TextChanged"
                                                     PreviewKeyDown="CanvasFilterBox_PreviewKeyDown" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="CanvasFilterCount"
                                           Grid.Column="1"
                                           Margin="10,0,6,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <Button x:Name="CanvasFilterPrevious" Grid.Column="2" Width="28" Height="26" Padding="0" Style="{StaticResource FlatButton}"
                                        Click="CanvasFilterPrevious_Click" ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match"
                                        Visibility="Collapsed">
                                    <TextBlock Text="&#xE70E;" Style="{StaticResource IconText}" FontSize="11" />
                                </Button>
                                <Button x:Name="CanvasFilterNext" Grid.Column="3" Width="28" Height="26" Padding="0" Style="{StaticResource FlatButton}"
                                        Click="CanvasFilterNext_Click" ToolTip="Next match (Enter)" AutomationProperties.Name="Next match"
                                        Visibility="Collapsed">
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="11" />
                                </Button>
                                <Button x:Name="CanvasFilterClear" Grid.Column="4" Width="28" Height="26" Padding="0" Style="{StaticResource FlatButton}"
                                        Click="CanvasFilterClear_Click" ToolTip="Clear the filter (Esc)" AutomationProperties.Name="Clear the filter"
                                        Visibility="Collapsed">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="10" />
                                </Button>
                            </Grid>

                            <!-- The order of the folder being worked with - the folder
                                 selected, or the one the selected file is in, else the one
                                 in view - or every folder's, as Canvas options says: a
                                 click sorts by the column, a second click turns it round. -->
                            <StackPanel x:Name="SortHeaders"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <Button x:Name="SortByName" Tag="Name" Style="{StaticResource SortHeaderButton}" Click="SortHeader_Click"
                                        ToolTip="Sort by Name (click again to reverse)" AutomationProperties.Name="Sort by Name">
                                    <StackPanel>
                                        <TextBlock x:Name="SortByNameArrow" Style="{StaticResource SortHeaderArrow}" />
                                        <TextBlock Text="Name" Style="{StaticResource SortHeaderLabel}" />
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Height="16" Margin="1,0" VerticalAlignment="Center" Background="{StaticResource BorderStrongBrush}" />
                                <Button x:Name="SortByModified" Tag="Modified" Style="{StaticResource SortHeaderButton}" Click="SortHeader_Click"
                                        ToolTip="Sort by Date modified (click again to reverse)" AutomationProperties.Name="Sort by Date modified">
                                    <StackPanel>
                                        <TextBlock x:Name="SortByModifiedArrow" Style="{StaticResource SortHeaderArrow}" />
                                        <TextBlock Text="Date modified" Style="{StaticResource SortHeaderLabel}" />
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Height="16" Margin="1,0" VerticalAlignment="Center" Background="{StaticResource BorderStrongBrush}" />
                                <Button x:Name="SortByType" Tag="Type" Style="{StaticResource SortHeaderButton}" Click="SortHeader_Click"
                                        ToolTip="Sort by Type (click again to reverse)" AutomationProperties.Name="Sort by Type">
                                    <StackPanel>
                                        <TextBlock x:Name="SortByTypeArrow" Style="{StaticResource SortHeaderArrow}" />
                                        <TextBlock Text="Type" Style="{StaticResource SortHeaderLabel}" />
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Height="16" Margin="1,0" VerticalAlignment="Center" Background="{StaticResource BorderStrongBrush}" />
                                <Button x:Name="SortBySize" Tag="Size" Style="{StaticResource SortHeaderButton}" Click="SortHeader_Click"
                                        ToolTip="Sort by Size (click again to reverse)" AutomationProperties.Name="Sort by Size">
                                    <StackPanel>
                                        <TextBlock x:Name="SortBySizeArrow" Style="{StaticResource SortHeaderArrow}" />
                                        <TextBlock Text="Size" Style="{StaticResource SortHeaderLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <controls:NestedCanvas x:Name="Nested"
                                           Grid.Row="1"
                                           AllowDrop="True"
                                           AutomationProperties.Name="Folders"
                                           DragOver="Nested_DragOver"
                                           DragLeave="Nested_DragLeave"
                                           Drop="Nested_Drop" />
                </Grid>

                <!-- The current folder as a plain list.  The canvas answers
                     "what is where"; this answers "where is the one called X",
                     which is the half a canvas is bad at. -->
                <Border x:Name="FolderListPanel"
                        PreviewMouseRightButtonDown="FolderListPanel_PreviewMouseRightButtonDown"
                        PreviewMouseRightButtonUp="FolderListPanel_PreviewMouseRightButtonUp"
                        Width="320"
                        Height="380"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="14"
                        CornerRadius="8"
                        Background="#F21C1C1C"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Visibility="{Binding Tree.FolderList.IsVisible, Converter={StaticResource BoolToVisibility}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.40" Color="#000000" />
                    </Border.Effect>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: which folder, how many, and a way out. -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- One arrow, not two: walking up and stepping back
                                 land in the same place nearly every time, and a
                                 button that duplicates its neighbour is worse
                                 than no button.  Back is still on Alt+Left. -->
                            <Button Grid.Column="0"
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource FlatButton}"
                                    Command="{Binding Tree.FolderList.UpCommand}"
                                    ToolTip="Up one folder (Alt+Up)"
                                    AutomationProperties.Name="Up one folder">
                                <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" FontSize="11" />
                            </Button>
                            <TextBlock Grid.Column="1"
                                       Text="&#xE8B7;"
                                       Style="{StaticResource IconText}"
                                       Foreground="{StaticResource FolderBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Tree.FolderList.Title}"
                                       ToolTip="{Binding Tree.FolderList.FolderPath}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Tree.FolderList.CountText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="6,0,4,0" />
                            <Button Grid.Column="4"
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    Style="{StaticResource FlatButton}"
                                    Command="{Binding Tree.FolderList.HideCommand}"
                                    ToolTip="Hide the folder list"
                                    AutomationProperties.Name="Hide the folder list">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="11" />
                            </Button>
                        </Grid>

                        <!-- Type to narrow it down; Enter opens the best match. -->
                        <Border Grid.Row="1"
                                CornerRadius="5"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="7,4"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE721;"
                                           Style="{StaticResource IconText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Find in this folder"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Tree.FolderList.Filter, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
                                    <TextBox x:Name="FolderListFilterBox"
                                             Text="{Binding Tree.FolderList.Filter, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}"
                                             CaretBrush="{StaticResource TextBrush}"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"
                                             KeyDown="FolderListFilter_KeyDown" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <controls:SelectionListBox x:Name="FolderListItems"
                                     ItemsSource="{Binding Tree.FolderList.Items}"
                                     SelectionMode="Extended"
                                     SelectionChanged="FolderListItems_SelectionChanged"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     MouseDoubleClick="FolderListItems_MouseDoubleClick"
                                     PreviewMouseLeftButtonDown="FolderListItems_PreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="FolderListItems_PreviewMouseLeftButtonUp"
                                     PreviewMouseRightButtonUp="FolderListItems_PreviewMouseRightButtonUp">
                                <controls:SelectionListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="6,4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- A row that appeared on disk while the folder was shown fades in. -->
                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0"
                                                                             To="1"
                                                                             Duration="0:0:0.15"
                                                                             FillBehavior="Stop">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:SelectionListBox.ItemContainerStyle>
                                <controls:SelectionListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left">
                                                <Image Source="{Binding Icon}"
                                                       Width="16"
                                                       Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Glyph}"
                                                           Style="{StaticResource IconText}"
                                                           FontSize="12"
                                                           Foreground="{Binding Tint}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       ToolTip="{Binding FullPath}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,6,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Detail}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </controls:SelectionListBox.ItemTemplate>
                            </controls:SelectionListBox>

                            <TextBlock Text="{Binding Tree.FolderList.EmptyText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="12"
                                       Visibility="{Binding Tree.FolderList.EmptyText, Converter={StaticResource StringToVisibility}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Search results -->
                <Border Width="420"
                        MaxHeight="520"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="14"
                        Padding="8"
                        CornerRadius="8"
                        Background="#F2242424"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.45" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SearchResults.Count, StringFormat=Search results ({0})}" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="{Binding SearchStatusText}" FontSize="9.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SearchStatusText}" />
                            </StackPanel>
                            <ProgressBar Grid.Column="1" Width="60" MaxWidth="60" Height="3" Margin="8,0" VerticalAlignment="Center" IsIndeterminate="True"
                                         Visibility="{Binding IsSearchBusy, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Column="2" Width="26" Height="26" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding CloseSearchCommand}">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="9" />
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Margin="8,10,8,14"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SearchStatusText}"
                                   Visibility="{Binding SearchResults.Count, Converter={StaticResource ZeroCountToVisibility}}" />
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SearchResults}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="450"
                                 MouseDoubleClick="SearchResults_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="8,6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SearchResultViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource FolderBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ParentPath}" FontSize="9.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Minimap -->
                <Border x:Name="MinimapPanel"
                        Width="200"
                        Height="124"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="14,14,14,56"
                        CornerRadius="6"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Background="#E6202020"
                        Visibility="{Binding IsMinimapShown, Converter={StaticResource BoolToVisibility}}">
                    <nodify:Minimap ItemsSource="{Binding Tree.RenderNodes}"
                                    ViewportLocation="{Binding ViewportLocation, ElementName=Editor}"
                                    ViewportSize="{Binding ViewportSize, ElementName=Editor}"
                                    ResizeToViewport="True"
                                    Zoom="Minimap_Zoom"
                                    Background="Transparent">
                        <nodify:Minimap.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ViewAllNodeViewModel}">
                                <Border Background="{Binding AccentBrush}" CornerRadius="1" Opacity="0.8" />
                            </DataTemplate>
                        </nodify:Minimap.ItemTemplate>
                        <nodify:Minimap.ItemContainerStyle>
                            <Style TargetType="{x:Type nodify:MinimapItem}">
                                <Setter Property="Location" Value="{Binding Location}" />
                                <Setter Property="Width" Value="{Binding Width}" />
                                <Setter Property="Height" Value="{Binding Height}" />
                            </Style>
                        </nodify:Minimap.ItemContainerStyle>
                        <nodify:Minimap.ViewportStyle>
                            <Style TargetType="Rectangle">
                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter Property="StrokeThickness" Value="1.5" />
                                <Setter Property="Fill" Value="#1460CDFF" />
                            </Style>
                        </nodify:Minimap.ViewportStyle>
                    </nodify:Minimap>
                </Border>

                <!-- Canvas controls -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="14"
                        Padding="3"
                        CornerRadius="6"
                        Background="#EB242424"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="30" Height="30" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-, Ctrl+wheel)" AutomationProperties.Name="Zoom out">
                            <TextBlock Text="&#xE949;" Style="{StaticResource IconText}" FontSize="12" />
                        </Button>
                        <Button Width="54" Height="30" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding ResetZoomCommand}" ToolTip="Reset to 100% (Shift+0)" AutomationProperties.Name="Reset to 100%">
                            <TextBlock Text="{Binding ZoomLabel}" FontSize="10.5" />
                        </Button>
                        <Button Width="30" Height="30" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl++, Ctrl+wheel)" AutomationProperties.Name="Zoom in">
                            <TextBlock Text="&#xE948;" Style="{StaticResource IconText}" FontSize="12" />
                        </Button>
                        <Button Width="30" Height="30" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding FitAllCommand}" ToolTip="Fit all (Shift+1) — Shift+2 fits the selection" AutomationProperties.Name="Fit all">
                            <TextBlock Text="&#xE9A6;" Style="{StaticResource IconText}" FontSize="12" />
                        </Button>
                        <Button x:Name="CanvasLayersButton" Width="30" Height="30" Padding="0" Style="{StaticResource FlatButton}" Click="LayersButton_Click" ToolTip="Layers: files, icons, details, counts, hidden items, marks" AutomationProperties.Name="Layers">
                            <TextBlock Text="&#xE81E;" Style="{StaticResource IconText}" FontSize="12" />
                        </Button>
                        <Button x:Name="CanvasSettingsButton" Width="30" Height="30" Padding="0" Style="{StaticResource FlatButton}" Click="SettingsButton_Click" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Toast -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Padding="12,8"
                        CornerRadius="6"
                        Background="#F22B2B2B"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Visibility="{Binding Toast.IsVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="44" Height="3" IsIndeterminate="True" Margin="0,0,10,0"
                                     Visibility="{Binding Toast.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Toast.Message}" VerticalAlignment="Center" FontSize="11.5" />
                        <Button Width="24" Height="24" Padding="0" Margin="9,0,0,0" Style="{StaticResource FlatButton}" Command="{Binding Toast.HideCommand}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="9" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="16,12"
                        CornerRadius="6"
                        Background="#CC2B2B2B"
                        Visibility="{Binding Tree.IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ProgressBar Width="140" Height="3" IsIndeterminate="True" />
                        <TextBlock Text="Reading drives…" Margin="0,10,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- File dialog footer: only ever visible when another program asked
             UltraExplorer to pick something for it. -->
        <Border x:Name="PickerFooter"
                Grid.Row="4"
                Visibility="Collapsed"
                Padding="14,10"
                Background="{StaticResource WindowBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding FileNameLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />

                <ComboBox x:Name="PickerNameBox"
                          Grid.Column="1"
                          IsEditable="True"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding RecentNames}"
                          Text="{Binding FileNameText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          AutomationProperties.Name="File name"
                          PreviewKeyDown="PickerNameBox_PreviewKeyDown" />

                <Button x:Name="PickerAcceptButton"
                        Grid.Column="2"
                        Style="{StaticResource DialogPrimaryButton}"
                        Content="{Binding OkLabel}"
                        IsEnabled="{Binding CanAccept}"
                        Click="PickerAccept_Click" />

                <TextBlock x:Name="PickerTypeLabel"
                           Grid.Row="1"
                           Text="Files of type:"
                           VerticalAlignment="Center"
                           Margin="0,9,12,0"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />

                <ComboBox x:Name="PickerTypeBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,9,12,0"
                          ItemsSource="{Binding Filters}"
                          DisplayMemberPath="DisplayText"
                          SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                          AutomationProperties.Name="Files of type" />

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,9,0,0"
                        Style="{StaticResource DialogButton}"
                        Content="Cancel"
                        Click="PickerCancel_Click" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="5" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusCountText}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusPathText}"
                           ToolTip="{Binding StatusPathText}"
                           Margin="18,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="24" Height="20" Padding="0" Style="{StaticResource FlatButton}" Command="{Binding FitAllCommand}" ToolTip="Fit all" AutomationProperties.Name="Fit all">
                        <TextBlock Text="&#xE9A6;" Style="{StaticResource IconText}" FontSize="10" />
                    </Button>
                    <Button x:Name="StatusLayersButton" Width="24" Height="20" Padding="0" Style="{StaticResource FlatButton}" Click="LayersButton_Click" ToolTip="Layers" AutomationProperties.Name="Layers">
                        <TextBlock Text="&#xE81E;" Style="{StaticResource IconText}" FontSize="10" />
                    </Button>
                    <Button x:Name="StatusSettingsButton" Width="24" Height="20" Padding="0" Style="{StaticResource FlatButton}" Click="SettingsButton_Click" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
