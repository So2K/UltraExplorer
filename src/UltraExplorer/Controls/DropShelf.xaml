<UserControl x:Class="UltraExplorer.Controls.DropShelf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltraExplorer.Controls"
             HorizontalAlignment="Right"
             VerticalAlignment="Stretch">
    <Grid>
        <!-- The tab at the window's edge while the shelf is away and holds something. -->
        <Border x:Name="Tab"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="26"
                Padding="0,10"
                CornerRadius="6,0,0,6"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1,1,0,1"
                Cursor="Hand"
                ToolTip="Shelf: links to what you dropped here, kept for 7 days"
                Visibility="Collapsed"
                AllowDrop="True"
                DragEnter="Tab_DragEnter"
                MouseLeftButtonUp="Tab_Click">
            <StackPanel>
                <TextBlock Text="&#xE7B8;" Style="{StaticResource IconText}" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrightBrush}" />
                <TextBlock x:Name="TabCount" Margin="0,6,0,0" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <Border x:Name="Panel"
                Width="520"
                MinWidth="300"
                Margin="0,10,10,10"
                CornerRadius="8"
                Background="{StaticResource CanvasBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                AllowDrop="True"
                ClipToBounds="True"
                Visibility="Collapsed"
                DragEnter="Panel_DragOver"
                DragOver="Panel_DragOver"
                DragLeave="Panel_DragLeave"
                Drop="Panel_Drop">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" X="2000" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12,8,8,8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Shelf" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="HeaderCount" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Links kept 7 days · drag out · Shift+drag to arrange · Ctrl+wheel zooms"
                                       Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="26" Height="26" Padding="0" Style="{StaticResource ChromeButton}" ToolTip="Show every card" Click="Fit_Click">
                                <TextBlock Text="&#xE9A6;" Style="{StaticResource IconText}" FontSize="11" />
                            </Button>
                            <Button Width="26" Height="26" Padding="0" Style="{StaticResource ChromeButton}" ToolTip="Clear the shelf" Click="Clear_Click">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="11" />
                            </Button>
                            <Button Width="26" Height="26" Padding="0" Style="{StaticResource ChromeButton}" ToolTip="Close" Click="Close_Click">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The board the cards lie on. -->
                <local:ShelfBoard x:Name="Board" Grid.Row="1" />

                <TextBlock x:Name="EmptyNote"
                           Grid.Row="1"
                           Text="Nothing on the shelf yet.&#x0a;Drop files or folders here - from the canvas, out of an archive, from anywhere."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="30,0"
                           FontSize="12"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource TextDimBrush}" />

                <!-- Lit while something is dragged over the shelf. -->
                <Border x:Name="DropHighlight"
                        Grid.Row="1"
                        Margin="8"
                        CornerRadius="6"
                        BorderThickness="2"
                        BorderBrush="{StaticResource AccentBrightBrush}"
                        Background="#2A3B82F6"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,8" CornerRadius="6" Background="#E61E1E1E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Release to put it on the shelf" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- The left edge: pulled, the shelf grows or shrinks. -->
                <Thumb Grid.RowSpan="2"
                       Width="7"
                       HorizontalAlignment="Left"
                       Cursor="SizeWE"
                       Opacity="0"
                       DragDelta="Grip_DragDelta"
                       DragCompleted="Grip_DragCompleted" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
