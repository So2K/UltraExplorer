<UserControl x:Class="UltraExplorer.Controls.ViewAllNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:UltraExplorer.Converters"
             Width="188"
             Height="44"
             Focusable="False"
             SnapsToDevicePixels="True"
             AutomationProperties.Name="{Binding DisplayName}"
             AutomationProperties.HelpText="{Binding FullPath}"
             MouseDoubleClick="Node_MouseDoubleClick"
             PreviewMouseRightButtonUp="Node_PreviewMouseRightButtonUp">
    <!-- The node is designed at 188 x 44 and scaled by depth, so a deep branch
         takes proportionally less canvas without a second set of templates. -->
    <UserControl.LayoutTransform>
        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
    </UserControl.LayoutTransform>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:ViewAllDetailVisibilityConverter x:Key="DetailVisibility" />
    </UserControl.Resources>

    <Grid>
        <!-- Dot level: a bare coloured slab, no text and no icon, so panning
             a whole drive stays cheap when the graph is zoomed far out. -->
        <Border x:Name="DotVisual"
                Margin="2,6"
                CornerRadius="2"
                Background="{Binding AccentBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- Defaults belong in the style: a locally set value would
                         outrank every trigger below it. -->
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0.9" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DetailLevel}" Value="Dot">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Border x:Name="Chip"
                VerticalAlignment="Center"
                CornerRadius="5"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="38" />
                    <Setter Property="Background" Value="{StaticResource NodeSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource NodeBorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDrive}" Value="True">
                            <Setter Property="Height" Value="44" />
                            <Setter Property="Background" Value="{StaticResource NodeRootSurfaceBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter Property="Opacity" Value="0.62" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DetailLevel}" Value="Dot">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{StaticResource NodeSurfaceHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource NodeBorderHoverBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource NodeSurfaceSelectedBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Colour label: a thin stripe, never a fill of the whole node. -->
                <Border Grid.Column="0"
                        Margin="1,7"
                        Width="3"
                        CornerRadius="2"
                        Background="{Binding AccentBrush}" />

                <!-- Disclosure chevron: directories only. -->
                <Button x:Name="Chevron"
                        Grid.Column="1"
                        Width="16"
                        Height="26"
                        Padding="0"
                        Style="{StaticResource FlatButton}"
                        Click="Chevron_Click"
                        ToolTip="Expand or collapse (double-click the node)" AutomationProperties.Name="Expand or collapse"
                        Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE76C;"
                               Style="{StaticResource IconText}"
                               FontSize="8"
                               RenderTransformOrigin="0.5,0.5"
                               Foreground="{StaticResource TextDimBrush}">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="{Binding ChevronAngle}" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>

                <!-- Icon doubles as the file drag handle, exactly like Explorer. -->
                <Grid x:Name="DragHandle"
                      Grid.Column="2"
                      Background="Transparent"
                      Cursor="Hand"
                      ToolTip="Drag to move this item into another folder"
                      PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="DragHandle_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp">
                    <Image Source="{Binding Icon}"
                           Width="16"
                           Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                    <TextBlock Text="{Binding Glyph}"
                               Style="{StaticResource IconText}"
                               FontSize="14"
                               Foreground="{Binding AccentBrush}"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                </Grid>

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center"
                            Margin="2,0,4,0"
                            Visibility="{Binding DetailLevel, Converter={StaticResource DetailVisibility}, ConverterParameter=Compact}">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}"
                               ToolTip="{Binding FullPath}" />
                    <TextBlock Text="{Binding SecondaryText}"
                               Margin="0,1,0,0"
                               FontSize="9.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextDimBrush}"
                               Visibility="{Binding DetailLevel, Converter={StaticResource DetailVisibility}, ConverterParameter=Detailed}" />
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Visibility="{Binding DetailLevel, Converter={StaticResource DetailVisibility}, ConverterParameter=Detailed}">
                    <TextBlock Text="&#xE70B;"
                               Style="{StaticResource IconText}"
                               FontSize="10"
                               Margin="2,0"
                               Foreground="{StaticResource AccentBrush}"
                               ToolTip="{Binding Note}"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="&#xE71B;"
                               Style="{StaticResource IconText}"
                               FontSize="10"
                               Margin="2,0"
                               Foreground="{StaticResource TextDimBrush}"
                               ToolTip="Reparse point — not followed automatically"
                               Visibility="{Binding IsReparsePoint, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="&#xE7BA;"
                               Style="{StaticResource IconText}"
                               FontSize="10"
                               Margin="2,0"
                               Foreground="{StaticResource DangerBrush}"
                               ToolTip="{Binding ErrorMessage}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="LoadMore"
                            Height="20"
                            Padding="5,0"
                            Margin="2,0,0,0"
                            Style="{StaticResource FlatButton}"
                            Click="LoadMore_Click"
                            ToolTip="This folder was capped — load more items" AutomationProperties.Name="This folder was capped — load more items"
                            Visibility="{Binding HasMoreChildren, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#x2026;" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                    </Button>
                    <TextBlock Text="{Binding LoadedChildCount, StringFormat={}{0:N0}}"
                               FontSize="9.5"
                               Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}"
                               Visibility="{Binding HasVisibleChildren, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ProgressBar Grid.Column="0"
                             Grid.ColumnSpan="5"
                             Height="2"
                             VerticalAlignment="Bottom"
                             Margin="6,0"
                             IsIndeterminate="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Drop target: a calm breathing outline, never a hard blink. -->
        <Border x:Name="DropGlow"
                IsHitTestVisible="False"
                CornerRadius="5"
                Margin="0,3"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                Background="{StaticResource AccentSoftBrush}"
                Opacity="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="DropPulse">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.45"
                                                         To="0.95"
                                                         Duration="0:0:0.75" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="DropPulse" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
