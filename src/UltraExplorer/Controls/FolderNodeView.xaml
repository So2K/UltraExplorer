<UserControl x:Class="UltraExplorer.Controls.FolderNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UltraExplorer.Models"
             xmlns:converters="clr-namespace:UltraExplorer.Converters"
             Width="420"
             MinWidth="320"
             MaxWidth="680"
             Focusable="False"
             AllowDrop="True"
             DragEnter="Node_DragEnter"
             DragOver="Node_DragOver"
             DragLeave="Node_DragLeave"
             Drop="Node_Drop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:ZoomDetailVisibilityConverter x:Key="ZoomDetailVisibility" />

        <Style x:Key="NodeHeaderButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>

        <Style x:Key="FileListItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowChrome" Background="{TemplateBinding Background}" CornerRadius="4" Margin="4,0" Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowChrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="RowChrome" Property="Background" Value="#334F7FFF" />
                                <Setter TargetName="RowChrome" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                                <Setter TargetName="RowChrome" Property="BorderThickness" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCut}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter Property="Opacity" Value="0.62" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Card"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{Binding AccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True"
                PreviewMouseRightButtonUp="HeaderOrCard_RightClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.38" Color="#000000" />
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="9,9,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding AccentBrush}" CornerRadius="9,0,0,0" />
                        <TextBlock Grid.Column="1" Text="&#xE700;" Style="{StaticResource IconText}" Foreground="{StaticResource TextDimBrush}" ToolTip="Drag this card on the canvas" />
                        <TextBlock Grid.Column="2" Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="17" Foreground="{StaticResource FolderBrush}" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="2,0,8,0">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                            <TextBlock Text="{Binding FullPath}" Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource NodeHeaderButton}" ToolTip="Add or edit note" Click="NoteButton_Click">
                                <TextBlock Text="&#xE70B;" Style="{StaticResource IconText}" />
                            </Button>
                            <Button Style="{StaticResource NodeHeaderButton}" ToolTip="Color label" Click="ColorButton_Click">
                                <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" />
                            </Button>
                            <Button Style="{StaticResource NodeHeaderButton}" ToolTip="Folder actions" Click="MoreButton_Click">
                                <TextBlock Text="&#xE712;" Style="{StaticResource IconText}" />
                            </Button>
                            <Button Style="{StaticResource NodeHeaderButton}" ToolTip="Close this branch" Click="CloseButton_Click">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="8,7,8,0"
                        Padding="10,8"
                        CornerRadius="6"
                        Background="#191E2936"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding IsNoteVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE70B;" Style="{StaticResource IconText}" FontSize="12" Foreground="{Binding AccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="34"
                                 MaxHeight="76"
                                 Padding="4,2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="11.5"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="This note is stored in the UltraExplorer workspace, not inside the folder" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Height="27"
                      Margin="10,7,10,0"
                      Visibility="{Binding DataContext.ViewportZoom, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ZoomDetailVisibility}, ConverterParameter=0.58}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="31,0,0,0" />
                    <TextBlock Grid.Column="1" Text="Modified" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Size" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0" />
                </Grid>

                <Grid Grid.Row="3"
                      MinHeight="72"
                      Visibility="{Binding DataContext.ViewportZoom, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ZoomDetailVisibility}, ConverterParameter=0.58}">
                    <ListBox x:Name="ItemsList"
                             Height="344"
                             Margin="4,0,4,0"
                             ItemsSource="{Binding VisibleItems}"
                             SelectionMode="Extended"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource FileListItem}"
                             SelectionChanged="ItemsList_SelectionChanged"
                             PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ItemsList_PreviewMouseMove"
                             MouseDoubleClick="ItemsList_MouseDoubleClick"
                             PreviewMouseRightButtonUp="ItemsList_PreviewMouseRightButtonUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FileItemViewModel}">
                                <Grid Height="32" ToolTip="{Binding FullPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Width="23" Height="26" Padding="0"
                                            Style="{StaticResource FlatButton}"
                                            Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}"
                                            Click="ExpandButton_Click"
                                            ToolTip="Expand as a connected node">
                                        <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="9" />
                                    </Button>
                                    <Grid Grid.Column="1" Width="18" Height="18">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="4,0,8,0" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" Margin="0,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Margin="10" Padding="12" CornerRadius="6" Background="#AA151922"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE783;" Style="{StaticResource IconText}" FontSize="20" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#B3151922" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="120" Height="3" IsIndeterminate="True" Foreground="{Binding AccentBrush}" />
                            <TextBlock Text="Reading folder…" Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Background="#0F1218" CornerRadius="0,0,9,9">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,4,0" />
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="145" Height="24" Padding="2,1" FontSize="10.5"
                                     Background="Transparent" BorderThickness="0" ToolTip="Filter this node" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding VisibleItemCountLabel}" Foreground="{StaticResource TextDimBrush}" FontSize="10.5" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="DropGlow"
                IsHitTestVisible="False"
                CornerRadius="10"
                BorderBrush="{StaticResource AccentBrightBrush}"
                BorderThickness="2"
                Background="#184F7FFF"
                Opacity="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="DropPulse">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.62" To="1" Duration="0:0:0.42" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="DropPulse" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
