<Window x:Class="UltraExplorer.SearchBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UltraExplorer.ViewModels"
        Title="Build a search" Width="660" Height="740" MinHeight="420" MinWidth="400"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource SurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" Foreground="{StaticResource TextBrush}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" Margin="10,0,28,0" />
                                                <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="16" Padding="24" CornerRadius="12" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.55" Color="#000000" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <TextBlock Text="Build a search" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Choose conditions. Every condition must match." Margin="0,5,0,14" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,8">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasExistingQuery, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                        <CheckBox Content="Keep existing query and add these conditions" Style="{StaticResource SearchCheckBox}" IsChecked="{Binding KeepExistingQuery}" Foreground="{StaticResource TextBrush}" />
                        <TextBox Text="{Binding OriginalQuery, Mode=OneWay}" IsReadOnly="True" MinHeight="36" MaxHeight="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="Existing query" />
                    </StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox SelectedValue="{Binding NameMatchMode}" SelectedValuePath="Tag" AutomationProperties.Name="Name match">
                            <ComboBoxItem Content="Contains text" Tag="{x:Static vm:SearchNameMatchMode.Contains}" />
                            <ComboBoxItem Content="Wildcard pattern" Tag="{x:Static vm:SearchNameMatchMode.Pattern}" />
                            <ComboBoxItem Content="Exact name" Tag="{x:Static vm:SearchNameMatchMode.Exact}" />
                        </ComboBox>
                        <TextBox x:Name="NameInput" Grid.Column="1" Margin="8,0,0,0" Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" AutomationProperties.Name="Name or pattern" />
                    </Grid>
                    <TextBlock Text="{Binding NameHint}" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Look for" Style="{StaticResource FieldLabel}" />
                            <ComboBox SelectedValue="{Binding ObjectKind}" SelectedValuePath="Tag" AutomationProperties.Name="Object type">
                                <ComboBoxItem Content="Files and folders" Tag="{x:Static vm:SearchObjectKind.Any}" />
                                <ComboBoxItem Content="Files only" Tag="{x:Static vm:SearchObjectKind.Files}" />
                                <ComboBoxItem Content="Folders only" Tag="{x:Static vm:SearchObjectKind.Folders}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Extensions" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" AutomationProperties.Name="Included extensions" />
                            <TextBlock Text="Example: png; jpg; svg. Leave blank for any." Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Inside folder and its subfolders" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" AutomationProperties.Name="Folder scope" />
                        <Button Grid.Column="1" Content="Use current" Style="{StaticResource FlatButton}" Margin="8,0,0,0" IsEnabled="{Binding HasCurrentFolder}" Click="UseCurrent_Click" />
                    </Grid>
                    <TextBlock Text="Leave blank to use the search's current scope." Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Exclude names or patterns" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ExcludedNamesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="56" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Excluded names, one per line" />
                    <TextBlock Text="One per line. Example: *backup* or draft" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Exclude extensions" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ExcludedExtensionsText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" AutomationProperties.Name="Excluded extensions" />
                    <TextBlock Text="Example: tmp; bak" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="Search that will run" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding QueryText, Mode=OneWay}" IsReadOnly="True" MinHeight="54" MaxHeight="88" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Effective search query" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{Binding ValidationMessage}" Visibility="{Binding HasValidationError, Converter={StaticResource VisibleWhenTrue}}"
                       Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource FlatButton}" MinWidth="86" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="Apply search" Style="{StaticResource AccentButton}" MinWidth="112" IsDefault="True" IsEnabled="{Binding CanApply}" Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
