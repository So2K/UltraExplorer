<UserControl x:Class="UltraExplorer.Picker.Integration.NativeOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltraExplorer.Picker.Integration"
             AutomationProperties.AutomationId="NativeDialogOptions">
    <!--
        The calling application's own options (check boxes, choices, lists,
        text), mirrored from its hidden Windows dialog in the window's dark
        surfaces, and the way back to that dialog.
    -->
    <UserControl.Resources>
        <Style x:Key="OptionCheckStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource WindowBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Tick" Property="Text" Value="&#xE738;" />
                                <Setter TargetName="Tick" Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionRadioStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1" Fill="{StaticResource SurfaceRaisedBrush}" />
                                <Ellipse x:Name="Dot" Margin="4" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="NativeCheck">
            <CheckBox Style="{StaticResource OptionCheckStyle}" Content="{Binding Label}" IsChecked="{Binding Checked, Mode=TwoWay}" IsThreeState="{Binding IsThreeState}"
                      IsEnabled="{Binding IsEnabled}" FontSize="12" Margin="0,5,22,5" Foreground="{StaticResource TextBrush}"
                      AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate x:Key="NativeRadio">
            <RadioButton Style="{StaticResource OptionRadioStyle}" Content="{Binding Label}" GroupName="{Binding RadioGroup}" IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                         FontSize="12" Margin="0,5,22,5" Foreground="{StaticResource TextBrush}"
                         AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate x:Key="NativeCombo">
            <StackPanel Margin="0,4,22,4" MinWidth="180" MaxWidth="320">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                          AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NativeText">
            <StackPanel Margin="0,4,22,4" MinWidth="180" MaxWidth="320">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled}"
                         Height="30" Padding="8,3" VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NativeLabel">
            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,22,5" TextWrapping="Wrap" MaxWidth="420" />
        </DataTemplate>
        <local:NativeOptionTemplateSelector x:Key="NativeTemplates" />
    </UserControl.Resources>
    <StackPanel>
        <Border x:Name="OptionsPanel" Margin="0,10,0,0" Padding="12,8,12,6" CornerRadius="6" Visibility="Collapsed"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="OptionsHeading" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="160">
                    <ItemsControl x:Name="OptionsList" ItemTemplateSelector="{StaticResource NativeTemplates}" Focusable="False"
                                  AutomationProperties.Name="Options of the application">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <DockPanel Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UseWindowsButton" Style="{StaticResource DialogButton}" Click="UseWindows_Click" Margin="12,0,0,0"
                        AutomationProperties.AutomationId="UseNativeDialog" AutomationProperties.Name="Use the Windows dialog this time">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Use the Windows dialog this time" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExcludeButton" Style="{StaticResource DialogButton}" Click="Exclude_Click" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="ExcludeNativeDialogApp" />
            </StackPanel>
            <TextBlock x:Name="ApplicationLabel" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" FontSize="11.5" TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
</UserControl>
